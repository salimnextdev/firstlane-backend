{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@app/auth/(.*)": "<rootDir>/../libs/auth/src/$1",
    "@app/auth": "<rootDir>/../libs/auth/src",
    "@app/user/(.*)": "<rootDir>/../libs/user/src/$1",
    "@app/user": "<rootDir>/../libs/user/src",
    "@app/admin/(.*)": "<rootDir>/../libs/admin/src/$1",
    "@app/admin": "<rootDir>/../libs/admin/src",
    "@app/kyc/(.*)": "<rootDir>/../libs/kyc/src/$1",
    "@app/kyc": "<rootDir>/../libs/kyc/src",
    "@app/investment-plan/(.*)": "<rootDir>/../libs/investment-plan/src/$1",
    "@app/investment-plan": "<rootDir>/../libs/investment-plan/src",
    "@app/investment/(.*)": "<rootDir>/../libs/investment/src/$1",
    "@app/investment": "<rootDir>/../libs/investment/src",
    "@app/wallet/(.*)": "<rootDir>/../libs/wallet/src/$1",
    "@app/wallet": "<rootDir>/../libs/wallet/src"
  }
}